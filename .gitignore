# This repository contains code plus an exact allowlist of disclosure-reviewed
# aggregate course outputs. These rules are defense in depth;
# tools/validate_release.py is the authoritative pre-publication check.

# Research data and generated artifacts (at any depth)
**/*.dta
**/*.dtas
**/*.sav
**/*.zsav
**/*.por
**/*.sas7bdat
**/*.sas7bcat
**/*.xpt
**/*.xlsx
**/*.xls
**/*.xlsb
**/*.ods
**/*.csv
**/*.tsv
**/*.json
**/*.parquet
**/*.feather
**/*.arrow
**/*.rds
**/*.rda
**/*.rdata
**/*.RData
**/*.mat
**/*.dat
**/*.h5
**/*.hdf5
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.jsonl
**/*.ndjson
**/*.geojson
**/*.gpkg
**/*.gdb/
**/*.shp
**/*.shx
**/*.dbf
**/*.prj
**/*.kml
**/*.kmz
**/*.gph
**/*.ster

# Archives, disk images, and binary document bundles
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.zst
**/*.dmg
**/*.iso
**/*.doc
**/*.docx
**/*.pdf

# Logs, temporary files, and rendered results
**/*.log
**/*.smcl
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.orig
**/*.swp
**/*.swo
**/*~
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.tif
**/*.tiff
**/*.eps
**/*.ps
**/*.tex
**/*.svg
**/*.aux
**/*.bbl
**/*.blg
**/*.toc
**/*.out
**/*.html
**/temp/
**/tmp/
**/logs/
**/results/
**/figures/
**/tables/

# The public tree retains only documentation placeholders in these directories.
/data/*
!/data/README.md
/rawdata/*
!/rawdata/README.md
/outputs/*
!/outputs/README.md

# ECON6067 course deliverables: only these aggregate/public artifacts are
# intentionally versioned. Raw and processed microdata remain excluded.
!/report.pdf
!/config/
!/config/project.json
!/config/input_manifest.json
!/config/published_benchmarks.csv
!/data/raw/
!/data/raw/README.md
!/data/processed/
!/data/processed/README.md
!/outputs/tables/
!/outputs/tables/table5_2000_bootstrap_summary.csv
!/outputs/tables/table5_paper_comparison.csv
!/outputs/tables/table5_point_validation.csv
!/outputs/tables/extension_timing_regression.csv
!/outputs/tables/extension_exposure_cells.csv
!/outputs/tables/extension_exposure_households.csv
!/outputs/tables/extension_neighbor_summary.csv
!/outputs/figures/
!/outputs/figures/table5_multiplier_comparison.png
!/outputs/figures/extension_exposure_cells.png

# Local run staging is never publishable.
/.runtime/

# Credentials and machine-local configuration
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.kdbx
**/.netrc
**/.Renviron
**/.Rhistory
**/.RData
**/.Rproj.user/

# Third-party Stata packages are installed upstream, not vendored here.
/ado/ssc/

# Operating-system, editor, and language caches
**/.DS_Store
**/Thumbs.db
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
